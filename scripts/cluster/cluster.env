# Cluster settings - filled in for the university DGX (dgx-login01), from 01_check_cluster.sh output.

# --- scheduler
GPU_PARTITION=gpu_student    # 7-day limit; account "student", QOS normal
CPU_PARTITION=cpu_student
ACCOUNT=                     # default account (student) is used automatically
# A 7B/8B model in bfloat16 needs ~16 GB of GPU memory plus working space:
#   gpu:a100:1            full A100 - best (fastest, big batches)
#   gpu:a100_3g.20gb:1    20 GB MIG slice - works, ~2x slower, use --batch-size 4 for agent runs
#   gpu:a100_1g.5gb / a100_2g.10gb   TOO SMALL for the models (fine for setup / data / probes)
GPU_GRES="gpu:a100:1"
EXTRA_SBATCH=""

# --- paths (this cluster has no separate scratch; home has plenty of space)
PROJECT_DIR=$HOME/irrev-project
SCRATCH_DIR=$HOME
ENV_DIR=$HOME/envs/irrev                  # Python virtual environment (no conda on this cluster)
export HF_HOME=$HOME/hf_cache             # model weights (~31 GB for Qwen 7B + Llama 8B)

# --- software
MODULES=""                   # no module system on this cluster
TORCH_CUDA=cu121             # PyTorch build for CUDA 12.1 (works with any recent NVIDIA driver)
PYTHON_BIN=python3           # system Python 3.10; Java 21 is already installed at /usr/bin/java

# --- precision: A100 supports bfloat16
export IRREV_DTYPE=bfloat16
